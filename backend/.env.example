# Copy to backend/.env and fill in what you have. Every key below is optional:
# RepairFlow runs in explicit FIXTURE/SIMULATED mode for any provider whose
# key is absent, and the UI/API surface that mode with visible badges.
# Never commit a real .env file.

ENVIRONMENT=development

# --- Operator demo authentication (HTTP Basic over the protected UI/API) ---
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=repairflow-demo

# --- Gemini (Pydantic AI coordinator) ---
# Google AI Studio API key. Without it, the coordinator runs on the
# deterministic fixture proposal path and every decision is labelled FIXTURE.
GEMINI_API_KEY=
# Researched primary model; see docs/13_GEMINI_INTEGRATION.md. If account
# access fails the phase-0 smoke test, set GEMINI_MODEL to the documented
# fallback (GEMINI_FALLBACK_MODEL) and record the change in docs/26.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.7-flash

# --- ElevenLabs (browser voice conversation) ---
# Server-side key; never sent to the browser. Required for real signed
# session URLs, webhook verification and audio retrieval.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Signing secret configured on the ElevenLabs post-call webhook.
ELEVENLABS_WEBHOOK_SECRET=
# Dedicated bearer secret ElevenLabs server tools must present; distinct
# from the webhook signing secret.
ELEVENLABS_TOOL_SECRET=

# --- Tavily (contractor research; optional/SHOULD HAVE) ---
TAVILY_API_KEY=

# --- Storage paths ---
# Leave unset. config.py's defaults are anchored to the backend/ package
# directory itself (BACKEND_DIR / "data" / ...), not the process's current
# working directory. A relative override here is resolved against cwd by
# pydantic-settings, which silently created backend/backend/data/ the one
# time this was set and uvicorn was started from inside backend/. If you
# need a non-default location, use an absolute path.

# --- Public callback base URL ---
# HTTPS tunnel origin (e.g. a Cloudflare Quick Tunnel) that ElevenLabs
# webhooks can reach. Not needed for fixture-mode local development.
PUBLIC_BASE_URL=http://localhost:8000

# --- CORS (JSON array) ---
CORS_ALLOW_ORIGINS=["http://localhost:5173"]
